{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/xudxud/2D-SDF-Generator"
        }
      ]
    }
  ]
}
